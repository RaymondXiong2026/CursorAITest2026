      "position": [
        200,
        280
      ],
      "webhookId": "agentmail-inbound"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json.body ?? $json;\n\nreturn [{\n  json: {\n    provider_msg_id: payload.provider_msg_id ?? payload.message_id ?? payload.id ?? '',\n    thread_id: payload.thread_id ?? '',\n    from_addr: payload.from ?? payload.from_addr ?? '',\n    to_addr: payload.to ?? payload.to_addr ?? '',\n    subject: payload.subject ?? '',\n    body_text: payload.body_text ?? payload.text ?? '',\n    body_html: payload.body_html ?? payload.html ?? '',\n    received_at: payload.received_at ?? new Date().toISOString()\n  }\n}];"
      },
      "id": "Normalize_Email",
      "name": "Normalize Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        430,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.RAG_API_BASE_URL}}/detect-language",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": $json.body_text\n}",
        "options": {}
      },
      "id": "Detect_Language",
      "name": "Detect Language",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        280
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
