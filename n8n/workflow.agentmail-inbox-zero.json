      "typeVersion": 2.2,
      "position": [
        2510,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    action: 'queue_for_human_review',\n    reason: 'low_confidence_or_high_risk',\n    email: {\n      provider_msg_id: $json.provider_msg_id,\n      from_addr: $json.from_addr,\n      subject: $json.subject\n    },\n    draft: $json.reply,\n    confidence: $json.confidence,\n    citations: $json.citations\n  }\n}];"
      },
      "id": "Build_Review_Payload",
      "name": "Build Review Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2740,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    action: 'auto_send',\n    to: $json.from_addr,\n    subject: `Re: ${$json.subject || ''}`,\n    body_text: $json.reply,\n    citations: $json.citations,\n    confidence: $json.confidence\n  }\n}];"
      },
      "id": "Build_Send_Payload",
      "name": "Build Send Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2740,
        280
      ]
    },
