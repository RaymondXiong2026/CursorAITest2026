      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_events(email_id, event_type, payload)\nVALUES (\n  NULL,\n  'agentmail_workflow_result',\n  '{{ JSON.stringify($json).replace(/''/g, '''''') }}'::jsonb\n);",
        "options": {}
      },
      "id": "Audit_Log",
      "name": "Audit Log",
      "type": "n8n-nodes-base.postgres",
