            {
              "leftValue": "={{$json.review_required}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "IF_Review_Required",
      "name": "IF Review Required",
