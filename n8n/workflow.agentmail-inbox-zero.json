      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1590,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.category}}",
              "rightValue": "auto_reply",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "IF_Auto_Reply",
      "name": "IF Auto Reply",
