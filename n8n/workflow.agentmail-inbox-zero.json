        "url": "={{$env.RAG_API_BASE_URL}}/rag/reply",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"subject\": $json.subject,\n  \"question\": $json.body_text,\n  \"customer_language\": $json.detected_lang,\n  \"max_chunks\": 5\n}",
        "options": {}
      },
      "id": "Generate_RAG_Reply",
      "name": "Generate RAG Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
