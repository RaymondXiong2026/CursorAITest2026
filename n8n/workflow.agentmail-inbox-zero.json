      "typeVersion": 3.2,
      "position": [
        890,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\nreturn [{\n  json: {\n    ...data,\n    detected_lang: data.lang || 'unknown'\n  }\n}];"
      },
      "id": "Attach_Language",
      "name": "Attach Language",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.RAG_API_BASE_URL}}/classify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"subject\": $json.subject,\n  \"body_text\": $json.body_text,\n  \"lang\": $json.detected_lang\n}",
        "options": {}
      },
      "id": "Classify_Inbox_Zero",
      "name": "Classify Inbox Zero",
      "type": "n8n-nodes-base.httpRequest",
