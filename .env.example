POSTGRES_USER=agentmail
POSTGRES_PASSWORD=agentmail
POSTGRES_DB=agentmail
DATABASE_URL=postgresql://agentmail:agentmail@postgres:5432/agentmail

RAG_API_BASE_URL=http://rag-api:8000
AGENTMAIL_SEND_URL=http://review-service:8100/mock/agentmail/send
HUMAN_REVIEW_QUEUE_URL=http://review-service:8100/review/queue

RAG_QDRANT_IN_MEMORY=false
RAG_QDRANT_URL=http://qdrant:6333
RAG_CONFIDENCE_THRESHOLD=0.55
RAG_LLM_PROVIDER=template
RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_OLLAMA_MODEL=qwen2.5:7b-instruct
RAG_ENABLE_TRANSLATION=false
RAG_LIBRETRANSLATE_URL=http://host.docker.internal:5000

REVIEW_AGENTMAIL_SEND_URL=http://review-service:8100/mock/agentmail/send
REVIEW_SEND_TIMEOUT_SECONDS=20
